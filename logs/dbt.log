    create or replace table `rideshare-analytics-497407`.`marts`.`mart_revenue_per_city_daily`
      
    
    

    
    OPTIONS(
      description=""""""
    )
    as (
      

select
    t.request_date,
    t.city_id,
    c.city_name,
    count(*)                                                       as trips,
    sum(case when t.is_completed then 1 else 0 end)                as completed_trips,
    sum(case when t.is_cancelled then 1 else 0 end)                as cancelled_trips,
    sum(t.final_fare)                                              as gross_revenue_inr,
    sum(t.surge_uplift_inr)                                        as surge_uplift_inr,
    avg(t.surge_multiplier)                                        as avg_surge,
    sum(case when t.is_paid_success = 1 then t.paid_amount else 0 end) as collected_revenue_inr,
    
    case when count(*) = 0 or count(*) is null
         then null
         else (sum(case when t.is_paid_failed = 1 then 1 else 0 end)::float)::float / (count(*))::float
    end
                                  as payment_failure_rate
from `rideshare-analytics-497407`.`marts`.`fct_trips` t
join `rideshare-analytics-497407`.`marts`.`dim_city` c on t.city_id = c.city_business_key
group by 1, 2, 3
order by 1, 2
    );
  
[0m19:28:34.242541 [debug] [Thread-2 (]: On model.rideshare_analytics.mart_eta_accuracy_by_city: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "rideshare_analytics", "target_name": "dev", "node_id": "model.rideshare_analytics.mart_eta_accuracy_by_city"} */

  
    

    create or replace table `rideshare-analytics-497407`.`marts`.`mart_eta_accuracy_by_city`
      
    
    

    
    OPTIONS(
      description=""""""
    )
    as (
      

select
    t.city_id,
    c.city_name,
    count(*)                                                 as completed_trips,
    avg(t.wait_seconds)                                       as avg_wait_seconds,
    median(t.wait_seconds)                                    as median_wait_seconds,
    avg(t.duration_min)                                       as avg_duration_min,
    median(t.duration_min)                                    as median_duration_min,
    avg(t.distance_km)                                        as avg_distance_km,
    sum(case when t.wait_seconds <= 180 then 1 else 0 end)::float / count(*) as pct_pickup_under_3min,
    sum(case when t.wait_seconds <= 300 then 1 else 0 end)::float / count(*) as pct_pickup_under_5min
from `rideshare-analytics-497407`.`marts`.`fct_trips` t
join `rideshare-analytics-497407`.`marts`.`dim_city` c on t.city_id = c.city_business_key
where t.is_completed
group by 1, 2
order by completed_trips desc
    );
  
